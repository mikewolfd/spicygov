{
  "name": "spicygov",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build-reader.mjs && vite --host 127.0.0.1",
    "build": "node scripts/build-ui.mjs --coverage unavailable",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:data": "node scripts/check-public-data.mjs",
    "dev:ops": "vite --config vite.ops.config.mjs --host 127.0.0.1 --open /ops/",
    "check:catalog": "node scripts/catalog-public-validation.mjs public",
    "coverage:consume": "node scripts/consume-coverage-release.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:assets": "node scripts/build-reader.mjs && tsc --noEmit && vite build"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.3.2"
  }
}
